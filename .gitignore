/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor

.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.nova
/.vscode
/.zed

# Local database files, if anyone points DB_CONNECTION at sqlite for a poke
/database/*.sqlite
/database/*.sqlite-journal

# The starter-kit scaffold is merged in and then deleted; never commit it
/_scaffold

# Wayfinder's generated route types. Regenerated on every build, and a 0.x
# minor can change their shape, so a committed copy only creates conflicts.
/resources/js/actions
/resources/js/routes
/resources/js/wayfinder

# Sound placeholders are not in the repo; public/sounds/README.md says what
# to drop in. Remove these two lines once the real effects are committed.
/public/sounds/*
!/public/sounds/README.md
