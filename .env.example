APP_NAME="Quiz"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Railway terminates TLS at its edge. Without this, Laravel generates http://
# URLs and both the Google OAuth redirect and secure cookies break.
# Keep it unset locally; set TRUSTED_PROXIES=* in Railway.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------- R0.4
# Postgres for dev and prod. Tests use SQLite in-memory via phpunit.xml,
# so migrations and queries must stay portable across both.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=quiz
DB_USERNAME=quiz
DB_PASSWORD=secret

# On Railway, leave the DB_* vars above unset and set this to the reference
# ${{Postgres.DATABASE_URL}} so traffic stays on the private network.
DB_URL=

# Host-side port forwards (docker-compose.yml).
#
# 5433, not 5432: a local Postgres install or another project's container
# usually already holds 5432, and the clash shows up as
# "Bind for 0.0.0.0:5432 failed: port is already allocated".
# Nothing inside the compose network uses this — it is only for a GUI client.
APP_PORT=8000
VITE_PORT=5173
FORWARD_DB_PORT=5433

# ---------------------------------------------------------------------
# database drivers, not file: file sessions break across redeploys and
# replicas on Railway. No Redis service is needed for the MVP.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

# The spec has no background jobs, so there is no queue worker to run.

# ---------------------------------------------------------------------
# Google is the only auth path (Phase 1). Use a separate OAuth client for
# local dev and for the Railway domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ---------------------------------------------------------------------
# Vite runs inside the `app` container; the browser reaches it on the host.
VITE_APP_NAME="${APP_NAME}"
